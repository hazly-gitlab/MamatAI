# ==============================================================================
# MAMAT AI ASSISTANT SYSTEM CONFIGURATION (.env)
# ==============================================================================

APP_NAME="MAMAT AI"
APP_URL=http://localhost
API_URL=http://localhost/api/v1
PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
SECRET_KEY=supersecretjwtkey_change_me_in_production_32_chars_at_least
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jarvis
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///jarvis.db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# REAL LLM PROVIDER CONFIGURATION
# Supported: openai, ollama, local_mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

STT_PROVIDER=browser
TTS_PROVIDER=browser
VISION_PROVIDER=openai

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60
USE_GPU=false
