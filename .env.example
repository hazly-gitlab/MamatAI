# Application Configuration
APP_NAME="MAMAT AI"
APP_URL=http://localhost
SECRET_KEY=super_secret_jarvis_key_change_me_in_production

# Relational & Cache Databases
DATABASE_URL=postgresql+asyncpg://jarvis_user:jarvis_password@postgres:5432/jarvis_db
REDIS_URL=redis://redis:6379/0

# Hybrid AI Architecture Providers (Ollama + OpenRouter)
LLM_PROVIDER=hybrid # hybrid, mock, openai, ollama, openrouter
LLM_MODEL=gpt-4o

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM (OpenRouter & Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash

# Speech & Vision Providers
STT_PROVIDER=gemini
TTS_PROVIDER=gemini
VISION_PROVIDER=mock

# Allowed HTTP/API domains for SSRF protection
ALLOWED_HTTP_DOMAINS=api.weatherapi.com,wttr.in,api.github.com,openrouter.ai
